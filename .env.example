# Chép thành .env.local khi chạy local (pnpm dev / pnpm preview). Trên server đặt trong
# /home/ubuntu/biztown-web/.env (xem deploy/docker-compose.yml).
# KHÔNG điền giá trị thật vào file này — nó được commit lên git.

# Domain dùng cho canonical, hreflang, sitemap (mặc định https://biztown.vn)
# NEXT_PUBLIC_SITE_URL=https://biztown.vn

# --- Email form liên hệ (/lien-he) ---
# Hộp thư gửi.
MAIL_USER=biztownofficial@townsoftvina.com
# Người nhận, cách nhau bằng dấu phẩy; bỏ trống thì gửi về MAIL_USER.
MAIL_TO=biztownofficial@townsoftvina.com

# Cách 1 — Microsoft 365 qua Microsoft Graph (ưu tiên khi đủ ba biến): App registration trên
# Entra ID, quyền Application "Mail.Send" của Microsoft Graph, đã Grant admin consent.
# MS_CLIENT_SECRET là "Value" của client secret (không phải "Secret ID").
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Cách 2 — Gmail: MAIL_USER là địa chỉ Gmail, MAIL_PASS là App Password
# (https://myaccount.google.com/apppasswords), không phải mật khẩu đăng nhập.
MAIL_PASS=

# Không cấu hình cách nào thì form liên hệ báo lỗi (API trả 503).
